# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# AI Provider Configuration
# =============================================================================
# Configure an OpenAI-compatible LLM endpoint for generating nurse checklists
# and doctor briefs. If AI_BASE_URL is not set, the system falls back to
# template-based local generation.
#
# AI_BASE_URL – Base URL of an OpenAI-compatible API (default: https://api.openai.com/v1)
# AI_API_KEY  – API key (optional; if unset, requests have no Authorization header)
# AI_MODEL    – Model name (optional; default: gpt-4o-mini)
# =============================================================================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# PostgreSQL Database Configuration
# =============================================================================
# Native PostgreSQL connection string (replaces Supabase client)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# =============================================================================
DATABASE_URL=postgresql://postgres:e87MI3IXkSeuAHIr@db.sucgbcidajnvjukafcrx.supabase.co:5432/postgres
